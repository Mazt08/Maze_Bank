rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function ownsUser(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function validUser() {
      return request.resource.data.keys().hasOnly([
          'uid', 'name', 'email', 'accountNumber', 'balance', 'createdAt'
        ])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 1
        && request.resource.data.name.size() <= 100
        && request.resource.data.email is string
        && request.resource.data.email.size() <= 320
        && request.resource.data.accountNumber is string
        && request.resource.data.accountNumber.matches('^MZB-[0-9]{6}$')
        && request.resource.data.balance is number
        && request.resource.data.balance >= 0
        && request.resource.data.createdAt is timestamp;
    }

    function validTransaction() {
      return request.resource.data.keys().hasOnly([
          'fromUid', 'toUid', 'fromAccount', 'toAccount', 'amount',
          'type', 'status', 'note', 'createdAt'
        ])
        && request.resource.data.fromUid == request.auth.uid
        && request.resource.data.toUid is string
        && request.resource.data.fromAccount is string
        && request.resource.data.toAccount is string
        && request.resource.data.amount is number
        && request.resource.data.amount > 0
        && request.resource.data.type in ['transfer', 'deposit', 'withdrawal']
        && request.resource.data.status in ['completed', 'pending', 'failed']
        && request.resource.data.note is string
        && request.resource.data.note.size() <= 200
        && request.resource.data.createdAt is timestamp;
    }

    match /users/{uid} {
      // User documents contain PII. Server Actions use the Admin SDK, so
      // browser writes are intentionally blocked from changing balances.
      allow read: if ownsUser(uid);
      allow create: if ownsUser(uid) && validUser();
      allow update: if ownsUser(uid)
        && validUser()
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.accountNumber == resource.data.accountNumber
        && request.resource.data.balance == resource.data.balance
        && request.resource.data.createdAt == resource.data.createdAt;
      allow delete: if false;
    }

    match /transactions/{txId} {
      allow read: if signedIn()
        && (resource.data.fromUid == request.auth.uid
          || resource.data.toUid == request.auth.uid);
      // Transfers are atomic server-side operations using Admin SDK.
      allow create: if signedIn() && validTransaction();
      allow update, delete: if false;
    }
  }
}