# ─── Firebase Client SDK (public — prefixed NEXT_PUBLIC_) ─────────────────────
# These values are safe to expose to the browser. Copy them from:
# Firebase Console → Project settings → Your apps → Web app → SDK setup & config

NEXT_PUBLIC_FIREBASE_API_KEY=AIza...
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=1234567890
NEXT_PUBLIC_FIREBASE_APP_ID=1:1234567890:web:abc123

# ─── Firebase Admin SDK (secret — server-only) ────────────────────────────────
# These values must NEVER be exposed to the client.
# Download a service account key from:
# Firebase Console → Project settings → Service accounts → Generate new private key

FIREBASE_PROJECT_ID=your-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project.iam.gserviceaccount.com

# The private key must be wrapped in double quotes and \n must be literal backslash-n
# Example:  FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIE...\n-----END PRIVATE KEY-----\n"
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# ─── Anthropic API (for MazeBot AI chatbot) ─────────────────────────────────
# Get your API key from: https://console.anthropic.com/api_keys
# Requires paid account (~$3-15 per 1M tokens)
# ANTHROPIC_API_KEY=sk-ant-...

# ─── OR DeepSeek API (CHEAPER alternative to Anthropic) ──────────────────────
# Get your API key from: https://platform.deepseek.com/
# Much cheaper: ~$0.14 per 1M input tokens, free tier available
# Set either ANTHROPIC_API_KEY or DEEPSEEK_API_KEY (not both needed)
# DEEPSEEK_API_KEY=sk-...
